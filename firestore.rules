rules_version = "2";

// This file is the repository source of truth for Firestore security rules.
//
// Deployment is currently manual:
// Firebase Console -> Firestore Database -> Rules -> paste -> Publish.
//
// Keep the complete ruleset in this file identical to the rules published in
// the studysync-orbital26 Firebase project.
//
// The CLI command `firebase deploy --only firestore:rules` is not currently
// configured because firebase.json has no "firestore" rules entry.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasNusEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches(
             "^[eE][0-9]{7}@[uU][.][nN][uU][sS][.][eE][dD][uU]$"
           );
    }

    function isVerifiedNusUser() {
      return hasNusEmail()
        && request.auth.token.email_verified == true;
    }

    // Users may read profiles because names are shown throughout the app.
    // Registration creates the profile before email verification.
    match /users/{userId} {
      allow read: if isVerifiedNusUser();

      allow create: if hasNusEmail()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(
             ["name", "email", "createdAt"])
        && request.resource.data.keys().hasOnly(
             ["name", "email", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      allow update: if isVerifiedNusUser()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(["name"])
        && request.resource.data.name is string;

      allow delete: if isVerifiedNusUser()
        && request.auth.uid == userId;
    }

    // Study spaces are curated data.
    match /studySpaces/{spaceId} {
      allow read: if isVerifiedNusUser();
      allow write: if false;

      match /reviews/{reviewId} {

        function isValidReview() {
          return request.resource.data.keys().hasAll(
                   ["userId", "userName", "rating", "comment",
                    "createdAt", "updatedAt"])
            && request.resource.data.keys().hasOnly(
                   ["userId", "userName", "rating", "comment",
                    "createdAt", "updatedAt"])
            && request.resource.data.userId == reviewId
            && request.resource.data.userName is string
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5
            && request.resource.data.comment is string
            && request.resource.data.comment.size() <= 300;
        }

        allow read: if isVerifiedNusUser();

        allow create: if isVerifiedNusUser()
          && request.auth.uid == reviewId
          && isValidReview()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isVerifiedNusUser()
          && request.auth.uid == reviewId
          && isValidReview()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if isVerifiedNusUser()
          && request.auth.uid == reviewId;
      }
    }

    match /sessions/{sessionId} {

      // Session date/time strings represent NUS local time (UTC+8).
      function hasValidSessionStart() {
        return resource.data.date is string
          && resource.data.startTime is string
          && resource.data.date.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}")
          && resource.data.startTime.matches("[0-9]{2}:[0-9]{2}");
      }

      function sessionStartAt() {
        let dateParts = resource.data.date.split("-");
        let timeParts = resource.data.startTime.split(":");

        return timestamp.date(
                 int(dateParts[0]),
                 int(dateParts[1]),
                 int(dateParts[2])
               )
               + duration.time(
                   int(timeParts[0]),
                   int(timeParts[1]),
                   0,
                   0
                 )
               - duration.value(8, "h");
      }

      function isBeforeSessionStart() {
        return hasValidSessionStart()
          && request.time < sessionStartAt();
      }

      function isWithinCheckInWindow() {
        return hasValidSessionStart()
          && request.time >= sessionStartAt() - duration.value(15, "m")
          && request.time <= sessionStartAt() + duration.value(15, "m");
      }

      // Validate the new session start time during create/edit.
      function hasValidRequestedSessionStart() {
        return request.resource.data.date is string
          && request.resource.data.startTime is string
          && request.resource.data.date.matches(
               "[0-9]{4}-[0-9]{2}-[0-9]{2}")
          && request.resource.data.startTime.matches(
               "[0-9]{2}:[0-9]{2}");
      }

      function requestedSessionStartAt() {
        let dateParts = request.resource.data.date.split("-");
        let timeParts = request.resource.data.startTime.split(":");

        return timestamp.date(
                 int(dateParts[0]),
                 int(dateParts[1]),
                 int(dateParts[2])
               )
               + duration.time(
                   int(timeParts[0]),
                   int(timeParts[1]),
                   0,
                   0
                 )
               - duration.value(8, "h");
      }

      function requestedTimeInMinutes(time) {
        let parts = time.split(":");
        return int(parts[0]) * 60 + int(parts[1]);
      }

      // This matches the payload currently written by CreateSession.jsx.
      function isValidSessionDocument() {
        let data = request.resource.data;
        let participants = data.participants.toSet();
        let attendance = data.get("attendance", {});

        return data.keys().hasAll([
                 "studySpaceId",
                 "studySpaceName",
                 "date",
                 "startTime",
                 "endTime",
                 "duration",
                 "studyMode",
                 "moduleCode",
                 "studyGoal",
                 "maxParticipants",
                 "creatorId",
                 "creatorName",
                 "participants",
                 "status",
                 "createdAt"
               ])
          && data.keys().hasOnly([
                 "studySpaceId",
                 "studySpaceName",
                 "date",
                 "startTime",
                 "endTime",
                 "duration",
                 "studyMode",
                 "moduleCode",
                 "studyGoal",
                 "maxParticipants",
                 "creatorId",
                 "creatorName",
                 "participants",
                 "status",
                 "createdAt",
                 "attendance"
               ])
          && data.studySpaceId is string
          && data.studySpaceName is string
          && data.date is string
          && data.startTime is string
          && data.endTime is string
          && data.date.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}")
          && data.startTime.matches("[0-9]{2}:[0-9]{2}")
          && data.endTime.matches("[0-9]{2}:[0-9]{2}")
          && data.duration is int
          && requestedTimeInMinutes(data.endTime)
               > requestedTimeInMinutes(data.startTime)
          && data.duration
               == requestedTimeInMinutes(data.endTime)
                    - requestedTimeInMinutes(data.startTime)
          && data.studyMode in ["Silent", "Discussion", "Both"]
          && data.moduleCode is string
          && data.moduleCode.size() <= 10
          && data.studyGoal is string
          && data.studyGoal.size() <= 120
          && data.maxParticipants is int
          && data.maxParticipants >= 2
          && data.maxParticipants <= 20
          && data.creatorId is string
          && data.creatorName is string
          && data.participants is list
          && data.participants.size() == participants.size()
          && data.participants.size() <= data.maxParticipants
          && data.creatorId in participants
          && data.status in ["Active", "Cancelled"]
          && data.createdAt is timestamp
          && attendance is map
          && attendance.keys().toSet()
               .difference(participants).size() == 0
          && exists(
               /databases/$(database)/documents/users/$(data.creatorId)
             )
          && exists(
               /databases/$(database)/documents/studySpaces/$(data.studySpaceId)
             )
          && get(
               /databases/$(database)/documents/studySpaces/$(data.studySpaceId)
             ).data.name == data.studySpaceName;
      }

      function onlyParticipantsChanged() {
        return resource.data.participants is list
          && request.resource.data.participants is list
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(["participants"]);
      }

      function isValidJoin() {
        let before = resource.data.participants.toSet();
        let after = request.resource.data.participants.toSet();

        return isVerifiedNusUser()
          && onlyParticipantsChanged()
          && resource.data.creatorId != request.auth.uid
          && resource.data.status == "Active"
          && !(request.auth.uid in before)
          && request.auth.uid in after
          && after.difference(before) == [request.auth.uid].toSet()
          && before.difference(after).size() == 0
          && request.resource.data.participants.size() == after.size()
          && request.resource.data.participants.size()
               <= resource.data.maxParticipants;
      }

      function isValidLeave() {
        let before = resource.data.participants.toSet();
        let after = request.resource.data.participants.toSet();
        let attendance = resource.data.get("attendance", {});

        return isVerifiedNusUser()
          && onlyParticipantsChanged()
          && resource.data.creatorId != request.auth.uid
          && resource.data.status == "Active"
          && isBeforeSessionStart()
          && request.auth.uid in before
          && !(request.auth.uid in attendance)
          && !(request.auth.uid in after)
          && before.difference(after) == [request.auth.uid].toSet()
          && after.difference(before).size() == 0
          && request.resource.data.participants.size() == after.size();
      }

      function isValidCheckIn() {
        let changedTopLevel =
          request.resource.data.diff(resource.data).affectedKeys();
        let beforeAttendance = resource.data.get("attendance", {});
        let afterAttendance = request.resource.data.get("attendance", {});
        let changedAttendance =
          afterAttendance.diff(beforeAttendance).affectedKeys();

        return isVerifiedNusUser()
          && resource.data.status == "Active"
          && request.auth.uid in resource.data.participants
          && isWithinCheckInWindow()
          && beforeAttendance is map
          && afterAttendance is map
          && !(request.auth.uid in beforeAttendance)
          && changedTopLevel.hasAll(["attendance"])
          && changedTopLevel.hasOnly(["attendance"])
          && changedAttendance.hasAll([request.auth.uid])
          && changedAttendance.hasOnly([request.auth.uid])
          && afterAttendance[request.auth.uid] == "in";
      }

      function isValidCreatorUpdate() {
        let before = resource.data.participants.toSet();
        let after = request.resource.data.participants.toSet();
        let changed =
          request.resource.data.diff(resource.data).affectedKeys();

        return isVerifiedNusUser()
          && resource.data.creatorId == request.auth.uid
          && resource.data.status == "Active"
          && isBeforeSessionStart()
          && hasValidRequestedSessionStart()
          && request.time < requestedSessionStartAt()
          && changed.size() > 0
          && changed.hasOnly([
               "studySpaceId",
               "studySpaceName",
               "date",
               "startTime",
               "endTime",
               "duration",
               "studyMode",
               "moduleCode",
               "studyGoal",
               "maxParticipants",
               "participants",
               "status"
             ])
          && request.resource.data.creatorId == resource.data.creatorId
          && request.resource.data.creatorName == resource.data.creatorName
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == after.size()
          && request.auth.uid in after
          && request.resource.data.maxParticipants is int
          && request.resource.data.maxParticipants >= 2
          && request.resource.data.maxParticipants <= 20
          && request.resource.data.participants.size()
               <= request.resource.data.maxParticipants
          && request.resource.data.status in ["Active", "Cancelled"]
          && !changed.hasAny(["attendance"])
          && isValidSessionDocument()
          && (
               !changed.hasAny(["participants"])
               || (
                    after.difference(before).size() == 0
                    && before.difference(after).intersection(
                         resource.data.get("attendance", {}).keys().toSet()
                       ).size() == 0
                  )
             );
      }

      allow read: if isVerifiedNusUser();

      allow create: if isVerifiedNusUser()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.participants == [request.auth.uid]
        && request.resource.data.maxParticipants is int
        && request.resource.data.maxParticipants >= 2
        && request.resource.data.maxParticipants <= 20
        && request.resource.data.status == "Active"
        && request.resource.data.createdAt == request.time
        && !request.resource.data.keys().hasAny(["attendance"])
        && hasValidRequestedSessionStart()
        && request.time < requestedSessionStartAt()
        && isValidSessionDocument();

      allow update: if isValidCreatorUpdate()
                    || isValidJoin()
                    || isValidLeave()
                    || isValidCheckIn();

      // Preserve delete capability only for an upcoming session with no
      // attendance history.
      allow delete: if isVerifiedNusUser()
        && resource.data.creatorId == request.auth.uid
        && isBeforeSessionStart()
        && resource.data.get("attendance", {}).keys().size() == 0;
    }

    match /notifications/{notificationId} {

      function notificationSessionExists() {
        return exists(
          /databases/$(database)/documents/sessions/$(request.resource.data.sessionId)
        );
      }

      function notificationUserExists() {
        return exists(
          /databases/$(database)/documents/users/$(request.resource.data.userId)
        );
      }

      function isValidNotificationRecipient() {
        let session = get(
          /databases/$(database)/documents/sessions/$(request.resource.data.sessionId)
        ).data;
        let userId = request.resource.data.userId;
        let type = request.resource.data.type;

        return userId != session.creatorId
          && (
               (
                 type == "session_updated"
                 && session.status == "Active"
                 && userId in session.participants
               )
               || (
                 type == "session_cancelled"
                 && session.status == "Cancelled"
                 && userId in session.participants
               )
               || (
                 type == "participant_removed"
                 && session.status == "Active"
                 && !(userId in session.participants)
               )
             );
      }

      allow read: if isVerifiedNusUser()
        && resource.data.userId == request.auth.uid;

      allow create: if isVerifiedNusUser()
        && request.resource.data.keys().hasOnly(
             ["userId", "message", "sessionId", "type", "read", "createdAt"])
        && request.resource.data.keys().hasAll(
             ["userId", "message", "sessionId", "type", "read", "createdAt"])
        && request.resource.data.userId is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 300
        && request.resource.data.sessionId is string
        && request.resource.data.type in [
             "session_updated",
             "session_cancelled",
             "participant_removed"
           ]
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && notificationSessionExists()
        && notificationUserExists()
        && get(
             /databases/$(database)/documents/sessions/$(request.resource.data.sessionId)
           ).data.creatorId == request.auth.uid
        && isValidNotificationRecipient();

      allow update: if isVerifiedNusUser()
        && resource.data.userId == request.auth.uid
        && resource.data.read == false
        && request.resource.data.read == true
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(["read"]);

      allow delete: if isVerifiedNusUser()
        && resource.data.userId == request.auth.uid;
    }
  }
}