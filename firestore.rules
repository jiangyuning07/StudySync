rules_version = "2";

// This file is the repository source of truth for Firestore security rules.
//
// Deployment is currently manual:
// Firebase Console -> Firestore Database -> Rules -> paste -> Publish.
//
// Keep the complete ruleset in this file identical to the rules published in
// the studysync-orbital26 Firebase project.
//
// The CLI command `firebase deploy --only firestore:rules` is not currently
// configured because firebase.json has no "firestore" rules entry.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Users may read profiles because names are shown throughout the app.
    // A user can create their own profile and later change only their name.
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(
             ["name", "email", "createdAt"])
        && request.resource.data.keys().hasOnly(
             ["name", "email", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(["name"])
        && request.resource.data.name is string;

      allow delete: if isSignedIn()
        && request.auth.uid == userId;
    }

    // Study spaces are curated data. Signed-in users can read them but clients
    // cannot create, modify, or delete them.
    match /studySpaces/{spaceId} {
      allow read: if isSignedIn();
      allow write: if false;

      // Reviews are stored using the review author's UID as the document ID.
      match /reviews/{reviewId} {

        function isValidReview() {
          return request.resource.data.keys().hasAll(
                   ["userId", "userName", "rating", "comment",
                    "createdAt", "updatedAt"])
            && request.resource.data.keys().hasOnly(
                   ["userId", "userName", "rating", "comment",
                    "createdAt", "updatedAt"])
            && request.resource.data.userId == reviewId
            && request.resource.data.userName is string
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5
            && request.resource.data.comment is string
            && request.resource.data.comment.size() <= 300;
        }

        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && request.auth.uid == reviewId
          && isValidReview()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isSignedIn()
          && request.auth.uid == reviewId
          && isValidReview()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if isSignedIn()
          && request.auth.uid == reviewId;
      }
    }

    match /sessions/{sessionId} {

      // A non-creator update must change only the participants field.
      function onlyParticipantsChanged() {
        return resource.data.participants is list
          && request.resource.data.participants is list
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(["participants"]);
      }

      // A participant may join only an active, non-full session and may add
      // only their own UID without removing or changing anyone else.
      function isValidJoin() {
        let before = resource.data.participants.toSet();
        let after = request.resource.data.participants.toSet();

        return isSignedIn()
          && onlyParticipantsChanged()
          && resource.data.creatorId != request.auth.uid
          && resource.data.status == "Active"
          && !(request.auth.uid in before)
          && request.auth.uid in after
          && after.difference(before) == [request.auth.uid].toSet()
          && before.difference(after).size() == 0
          && request.resource.data.participants.size() == after.size()
          && request.resource.data.participants.size()
               <= resource.data.maxParticipants;
      }

      // A participant may leave by removing only their own UID. They cannot
      // add, remove, or reorder another participant through this permission.
      function isValidLeave() {
        let before = resource.data.participants.toSet();
        let after = request.resource.data.participants.toSet();

        return isSignedIn()
          && onlyParticipantsChanged()
          && resource.data.creatorId != request.auth.uid
          && resource.data.status == "Active"
          && request.auth.uid in before
          && !(request.auth.uid in after)
          && before.difference(after) == [request.auth.uid].toSet()
          && after.difference(before).size() == 0
          && request.resource.data.participants.size() == after.size();
      }

      // A participant may set only their OWN attendance key, only on a session they
      // have joined, only while the session is Active, and without touching any other
      // field. This mirrors the participants pattern: the affectedKeys check pins the
      // write down to exactly attendance.{uid} and nothing else. 

      function isValidCheckIn() {
        let changed =
          request.resource.data.diff(resource.data).affectedKeys();

        return isSignedIn()
          && resource.data.status == "Active"
          && request.auth.uid in resource.data.participants
          && changed.hasOnly(["attendance"])
          && request.resource.data.attendance.diff(
               resource.data.get("attendance", {})
             ).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.attendance[request.auth.uid] in ["in", "out"];
      }
 
      // Creators may edit their own session. They cannot transfer ownership,
      // replace the creation time, add participants manually, remove
      // themselves, exceed the participant limit, or reactivate a cancelled
      // session.
      function isValidCreatorUpdate() {
        let before = resource.data.participants.toSet();
        let after = request.resource.data.participants.toSet();
        let changed =
          request.resource.data.diff(resource.data).affectedKeys();

        return isSignedIn()
          && resource.data.creatorId == request.auth.uid
          && request.resource.data.creatorId == resource.data.creatorId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == after.size()
          && request.auth.uid in after
          && request.resource.data.maxParticipants is int
          && request.resource.data.maxParticipants >= 2
          && request.resource.data.maxParticipants <= 20
          && request.resource.data.participants.size()
               <= request.resource.data.maxParticipants
          && request.resource.data.status in ["Active", "Cancelled"]
          && (
               resource.data.status != "Cancelled"
               || request.resource.data.status == "Cancelled"
             )
          && (
               !changed.hasAny(["participants"])
               || after.difference(before).size() == 0
             );
      }

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants == [request.auth.uid]
        && request.resource.data.maxParticipants is int
        && request.resource.data.maxParticipants >= 2
        && request.resource.data.maxParticipants <= 20
        && request.resource.data.status == "Active"
        && request.resource.data.createdAt == request.time;

      allow update: if isValidCreatorUpdate()
                    || isValidJoin()
                    || isValidLeave()
                    || isValidCheckIn();

      allow delete: if isSignedIn()
        && resource.data.creatorId == request.auth.uid;
    }

    match /notifications/{notificationId} {

      // Recipients may read only their own notifications.
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      // Only the creator of the referenced session may create notifications.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(
             ["userId", "message", "sessionId", "type", "read", "createdAt"])
        && request.resource.data.keys().hasAll(
             ["userId", "message", "sessionId", "type", "read", "createdAt"])
        && request.resource.data.userId is string
        && request.resource.data.message is string
        && request.resource.data.sessionId is string
        && request.resource.data.type in [
             "session_updated",
             "session_cancelled",
             "participant_removed"
           ]
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && get(
             /databases/$(database)/documents/sessions/$(request.resource.data.sessionId)
           ).data.creatorId == request.auth.uid;

      // The recipient may only change an unread notification to read.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.read == false
        && request.resource.data.read == true
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(["read"]);

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }
  }
}