// NOTE: This file is the source of truth for Firestore rules in the repo, but
// it may not match what is currently live. Reconcile it with the Firebase
// console before deploying.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// It is deliberately NOT wired into firebase.json. Doing so would make the
// emulator enforce these rules during CI, and the current integration tests
// create user docs with addDoc() (random doc id, uid in a field), which the
// users rule below would reject. Tighten those tests to write users via
// setDoc(doc(db, "users", uid)) and to authenticate, then wire this in.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Anyone signed in can read profiles (names are shown on session cards);
    // a user may only write their own profile document.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Study spaces are curated/seeded, so clients read but do not write.
    match /studySpaces/{spaceId} {
      allow read: if isSignedIn();
      allow write: if false;

      // Reviews are keyed by the author's uid, so "one review per user per
      // space" is enforced by the path itself and edits only ever touch a
      // document the caller owns.
      match /reviews/{reviewId} {
        allow read: if isSignedIn();

        allow create, update: if isSignedIn()
          && request.auth.uid == reviewId
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment.size() <= 300;

        allow delete: if isSignedIn() && request.auth.uid == reviewId;
      }
    }

    // Baseline session rules. Tightening join/leave/edit further is possible
    // but out of scope for the notifications issue, so this stays permissive
    // for signed-in users, matching current behaviour.
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isSignedIn();
    }

    // Notifications. Because notifications are written from the browser, the
    // rules do the work of stopping a user from forging or tampering with
    // someone else's notifications.
    match /notifications/{notificationId} {

      // You only ever see your own notifications.
      allow read: if isSignedIn()
                  && resource.data.userId == request.auth.uid;

      // A notification can only be created by the creator of the session it
      // refers to. The get() confirms the caller owns that session, so a
      // random user cannot spam notifications to other people. The shape is
      // also locked down: exactly these fields, unread on creation.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(
             ["userId", "message", "sessionId", "type", "read", "createdAt"])
        && request.resource.data.userId is string
        && request.resource.data.message is string
        && request.resource.data.sessionId is string
        && request.resource.data.read == false
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.creatorId == request.auth.uid;

      // The recipient can only flip the read flag, nothing else.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);

      // The recipient may delete their own notifications.
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }
  }
}
